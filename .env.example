# Secreto maestro. Con esto se firman los enlaces personales y se calcula el sorteo.
# Genera uno con: openssl rand -hex 32
# OJO: si lo cambias despues de repartir los enlaces, todos los enlaces dejan de
# servir y el sorteo se rehace.
APP_SECRET=

# Contraseña para entrar a /admin (solo tu). Minimo 6 caracteres.
ADMIN_PASSWORD=

# Opcional. Cambia el sorteo sin cambiar los enlaces.
SORTEO_SEED=

# Redis. Usa UNA de las dos opciones.
# 1) Por TCP (Render Key Value, Railway, un Redis propio):
REDIS_URL=

# 2) Por REST (Upstash):
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Opcional. Fuerza la URL base de los enlaces del panel si el dominio no se detecta bien.
NEXT_PUBLIC_SITE_URL=
